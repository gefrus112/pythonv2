{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Python v2 file",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "pyv2", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Python v2 REPL",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "pyv2"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "new" },
      "problemMatcher": []
    },
    {
      "label": "Run Python v2 tests",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-t", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
