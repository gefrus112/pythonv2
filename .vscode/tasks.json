{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Python v2 file",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "pyv2", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Python v2 REPL",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "pyv2"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "new" },
      "problemMatcher": []
    },
    {
      "label": "Open Python v2 Sudbury Launcher",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "pyv2.launcher"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "new" },
      "problemMatcher": []
    },
    {
      "label": "Run PyHope engine demo",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "pyhope", "--demo"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Serve Python v2 website + games",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "http.server", "8000", "--bind", "0.0.0.0"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "new" },
      "problemMatcher": []
    },
    {
      "label": "Check current Python v2 app",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "pyv2", "check", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build current app: Windows kit",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "pyv2", "build", "${file}", "--output", "${workspaceFolder}/build/windows"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Run Python v2 tests",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-t", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
